# Только публичные frontend-настройки; service role никогда не добавляйте в VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Никнейм-вход: secrets Edge Function resolve-username — SUPABASE_URL,
# SUPABASE_ANON_KEY и SUPABASE_SERVICE_ROLE_KEY (только серверная среда).

# Удаление аккаунта: secrets Edge Function delete-account — SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY (только серверная среда).

# Storage: создайте приватный bucket "nexora-media" в Supabase Dashboard → Storage.
# Миграция 005 добавляет политики для этого bucket.

# В Supabase Auth включите подтверждение Email и добавьте Redirect URL:
# http://localhost:5173/auth/confirm
# http://localhost:5173/auth/reset-password
# https://your-production-domain.example/auth/confirm
# https://your-production-domain.example/auth/reset-password
# Для доставки писем настройте SMTP в Authentication > SMTP Settings.
